{
  "name": "saravault",
  "productName": "Sara Vault",
  "private": true,
  "version": "1.0.0",
  "description": "Premium FiveM Lua and NUI JavaScript obfuscation desktop tool",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Sara Soft",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "verify": "npx tsx scripts/verify/verify-shield.mjs",
    "icons": "node scripts/build/generate-icon.mjs",
    "predist": "node scripts/build/pre-dist.mjs",
    "dist": "npm run predist && npm run icons && npm run build && electron-builder --win portable && node scripts/build/copy-release.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "framer-motion": "^12.16.0",
    "javascript-obfuscator": "^5.4.3",
    "luaparse": "^0.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.1.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.sarasoft.saravault",
    "productName": "Sara Vault",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/preload.cjs",
      "node_modules/javascript-obfuscator/**/*"
    ],
    "extraResources": [
      {
        "from": "public/logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "SaraVault-Portable.${ext}"
    },
    "portable": {
      "artifactName": "SaraVault-Portable.${ext}"
    }
  }
}
